{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Stellar secret seed (SEP-23 strkey starting with S)",
            "patterns": ["/\\bS[A-Z2-7]{50,60}\\b/"]
          },
          {
            "name": "Hodle API key (sandbox or live) (INV-12)",
            "patterns": ["/\\bhodle_(test|live)_[0-9a-f]{32,}\\b/"]
          },
          {
            "name": "Stellar mainnet passphrase outside Markdown (INV-07)",
            "filePathGlobs": ["**", "!**/*.md"],
            "patterns": ["/Public Global Stellar Network ; September 2015/"]
          },
          {
            "name": "Hodle production host outside Markdown (INV-07)",
            "filePathGlobs": ["**", "!**/*.md"],
            "patterns": ["/https:\\/\\/api\\.hodle\\.com\\.br/"]
          },
          {
            "name": "committed env file (INV-12)",
            "filePathGlobs": ["**/.env", "**/.env.*", "!**/.env.example"]
          }
        ]
      }
    }
  ]
}
