# Vants PoC: testnet and sandbox only (SPEC §0, INV-07). Copy to .env; never commit .env.

# --- Postgres (local; `docker compose up -d postgres`) -------------------------------------------
DATABASE_URL=postgres://vants:vants@localhost:5433/vants

# --- Stellar testnet -------------------------------------------------------------------------------
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Testnet treasury hot key (worker only). S… seed.
TREASURY_SECRET=

# --- Hodle sandbox (SPEC DEC-005) -----------------------------------------------------------------
HODLE_SANDBOX_BASE_URL=https://sandbox-api.hodle.com.br
HODLE_SANDBOX_API_KEY=
# JSON map of event → webhook secret, from app-sandbox.hodle.com.br → API Keys → Webhooks (SPEC §11 Q1)
HODLE_WEBHOOK_SECRETS={}

# --- Pier (deployed testnet instance, SPEC DEC-012) ------------------------------------------------
PIER_API_URL=https://pier.example.com
PIER_API_KEY=
# whsec_… returned once when the treasury subscription's webhook is created
PIER_WEBHOOK_SECRET=
# Written by `pnpm pier:setup`
PIER_SUBSCRIPTION_ID=

# --- CCTP refill (Base Sepolia) --------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
EVM_TEST_PRIVATE_KEY=
IRIS_API_URL=https://iris-api-sandbox.circle.com

# --- Public URL for webhook ingress (Cloudflare tunnel for local runs) --------------------------------
PUBLIC_BASE_URL=

# --- Integrator API keys are hashed with this pepper ------------------------------------------------
INTEGRATOR_KEY_PEPPER=

# --- Test payer for end-to-end runs (testnet only; generated by setup-testnet-funds.ts) ------------
TEST_PAYER_SECRET=
# Testnet account holding a DeFindex position, for `pnpm exit:smoke` only.
DEFINDEX_USER_SECRET=

# --- Vants Pay API (T-010) -------------------------------------------------------------------------
# Public G… key of the treasury (the api never holds TREASURY_SECRET). Deposits go to its muxed addresses.
TREASURY_ACCOUNT=
# Optional: API_PORT (3100), FUNDING_ASSETS (comma-separated CODE:ISSUER; default Circle + Blend testnet USDC),
# QUOTE_RATE_BRL_PER_USD (5.4), FEE_MODEL (sandbox | hodle-default), QUOTE_TTL_SECONDS (120)
# Optional (worker): FLOAT_MIN_USD (10): FloatLow below this; FLOAT_TARGET_USD (25): refill up to this (T-015, T-016)
# Optional (worker): CCTP_CAP_USD (1): the most USDC one float refill bridges (T-016)
# Optional (api): EXIT_ROUTER_CONTRACT_ID: the deployed exit router (C…, contracts/exit-router, DEC-031)

# --- Mini-app login (SEP-10, T-020) -------------------------------------------------------------------
# The SEP-10 server key (S…, a dedicated keypair: never the treasury) and the JWT HMAC secret (64 hex). With PUBLIC_BASE_URL
# they enable /.well-known/stellar.toml, /auth and /app/*.
WEB_AUTH_SIGNING_SECRET=
JWT_SECRET=
